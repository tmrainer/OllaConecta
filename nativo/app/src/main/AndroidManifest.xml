<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Un toque corto al marcar a alguien o deshacer. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Avisos de entrega con la app cerrada (AvisosTelefono.kt): mostrarlos
         (Android 13+ pide permiso) y volver a programarlos al encender el teléfono. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Leer el DNI y los QR con la cámara de atrás. Sin cámara, la app funciona
         igual: se escribe a mano. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Leer en voz alta (Voz.kt): Android 11+ solo deja ver el motor de voz si se declara. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- El correo a UNACEM se abre en una app de correo (Compartir.kt). -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <!-- allowBackup: a propósito. Android puede sumar los datos de la app a la
         copia de seguridad de Google del teléfono. La app lo explica en «Tus datos». -->
    <application
        android:name=".OllaConectaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OllaConecta">

        <!-- Siempre de pie: al acomodar el DNI frente a la cámara el teléfono se inclina y
             la app no debe girar. Donde Android no deja fijarla (tablets, plegables), un
             giro o un cambio de tamaño no reinicia la pantalla: no se pierde la cámara
             abierta ni lo que se estaba escribiendo. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.OllaConecta.Inicio"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El reconocimiento de texto (la MRZ del DNI) y de códigos (los QR) los
             instalan los servicios de Google Play una sola vez; la app no se conecta a nada. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archivos" />
        </provider>

        <receiver android:name=".ReceptorEleccion" android:exported="false" />
        <receiver android:name=".ReceptorRecordatorio" android:exported="false" />

        <receiver android:name=".ReceptorAvisos" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
